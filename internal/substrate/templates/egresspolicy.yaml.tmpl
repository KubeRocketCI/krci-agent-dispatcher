# Per-issue egress policy (protojson ateapi.EgressPolicy), Go text/template: Anthropic API, GitLab, then the hosts of
# the profile entry as TLS passthrough on 443. All other hosts denied.
# Dispatcher, harness and agent images: docs/agent-harness.md.
rules:
- https:
    hostnames: ["api.anthropic.com"]
    effects:
      replaceHeaders:
      - header: x-api-key
        credentialUri: {{ json (secret "anthropic/api-key") }}
- https:
    hostnames: [{{ json .GitLabURL.Host }}]
    effects:
      replaceHeaders:
      - header: Authorization
        prefix: "Basic "
        credentialUri: {{ json (secret "gitlab/basic") }}
      - header: PRIVATE-TOKEN
        credentialUri: {{ json (secret "gitlab/token") }}
{{- if .Profile.Egress }}
- tlsPassthrough:
    hostnames: {{ json .Profile.Egress }}
    ports:
      numbers: [443]
{{- end }}
