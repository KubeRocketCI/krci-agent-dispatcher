# Per-issue ActorTemplate (protojson ateapi.ActorTemplate), Go text/template.
# Values are JSON-quoted (`json`): project path, bot name and profile entry come from event payloads and config.
# Dispatcher, harness and agent images: docs/agent-harness.md.
workerSelector:
  matchLabels:
    workload: {{ json .WorkerPool }}
containers:
- name: claude
  image: {{ json .Profile.Image }}
  command: ["/opt/krci-agent/krci-agent-harness", "run"]
  env:
  - name: GITLAB_URL
    value: {{ json .GitLabURL.String }}
  - name: PROJECT_ID
    value: {{ json (print .ProjectID) }}
  - name: PROJECT_PATH
    value: {{ json .ProjectPath }}
  - name: ISSUE_IID
    value: {{ json (print .IID) }}
  - name: BOT_USERNAME
    value: {{ json .BotUsername }}
  - name: SESSION_ID
    value: {{ json .SessionID }}
  - name: AGENT_CONTRACT_VERSION
    value: {{ json (print contractVersion) }}
  - name: TURN_TIMEOUT_SECONDS
    value: {{ json (print (seconds .TurnTimeout)) }}
  - name: POLL_SECONDS
    value: {{ json (print (seconds .HarnessPoll)) }}
  - name: TURN_LIMIT
    value: {{ json (print .TurnLimit) }}
  - name: AGENT_STEPS
    value: {{ json (print .AgentSteps) }}
  - name: HOME
    value: /home/agent
  - name: AGENT_PROFILE
    value: {{ json .Profile.Name }}
  - name: ANTHROPIC_API_KEY
    value: placeholder
  - name: ANTHROPIC_MODEL
    value: {{ json .Model }}
  - name: CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
    value: "1"
  - name: SSL_CERT_FILE
    value: /run/ate/egress-trust-bundle/trust-bundle.pem
  - name: NODE_EXTRA_CA_CERTS
    value: /run/ate/egress-trust-bundle/trust-bundle.pem
  - name: GIT_SSL_CAINFO
    value: /run/ate/egress-trust-bundle/trust-bundle.pem
  - name: GIT_AUTHOR_NAME
    value: KRCI Agent
  - name: GIT_AUTHOR_EMAIL
    value: krci-agent@example.invalid
  - name: GIT_COMMITTER_NAME
    value: KRCI Agent
  - name: GIT_COMMITTER_EMAIL
    value: krci-agent@example.invalid
  # Profile env; a name set above is refused by Render.
  {{- range .Profile.Env }}
  - name: {{ json .Name }}
    value: {{ json .Value }}
  {{- end }}
  volumeMounts:
  - name: system-info
    mountPath: /run/ate
  - name: harness
    mountPath: /opt/krci-agent
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - trustBundle:
        names:
        - egress-mitm.ate.dev
        - system-roots.ate.dev
        path: egress-trust-bundle/trust-bundle.pem
- name: harness
  image:
    reference: {{ json .HarnessImage }}
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 2147483648 # 2Gi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  # The golden actor runs the command at template creation, with no egress.
  goldenSnapshotConfig:
    mode: GOLDEN_SNAPSHOT_MODE_DISABLED
